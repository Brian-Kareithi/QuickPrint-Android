<?xml version="1.0" encoding="utf-8"?>
<!-- Private chat keys must never leave the device (Android 12+). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="quickprint_chat.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="quickprint_chat.xml" />
    </device-transfer>
</data-extraction-rules>
